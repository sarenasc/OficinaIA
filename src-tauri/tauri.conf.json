{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oficina IA Local",
  "version": "0.1.0",
  "identifier": "local.oficina.ia",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {
    "windows": [{"title": "Oficina IA Local", "width": 1300, "height": 850, "minWidth": 900, "minHeight": 650}],
    "security": {"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:38080 ws://127.0.0.1:38080; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"}
  },
  "bundle": {"active": false}
}
